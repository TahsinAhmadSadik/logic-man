  "problemId": "prob_50",
  "exportedAt": "2026-08-16T00:00:00.000Z",
  "debugChanges": {
    "summary": "Fixed erroneous direct connection of signed overflow output V to C_4. Added an overflow detector XOR gate computing V = C_3 XOR C_4 using an additional 7486 IC on block M1.",
    "fixes": [
      {
        "type": "added",
        "wireId": "wire_fix_vcc_7486",
        "reason": "Connected Pin 14 (VCC) of the new 7486 XOR IC at M1-Col 12 to BUS_TOP_VCC_12."
      },
      {
        "type": "added",
        "wireId": "wire_fix_gnd_7486",
        "reason": "Connected Pin 7 (GND) of the new 7486 XOR IC at M1-Col 12 to BUS_BOT_GND_18."
      },
      {
        "type": "added",
        "wireId": "wire_fix_c3_to_xor",
        "reason": "Connected carry into sign bit C_3 (BB_D37) to XOR Gate 1 input Pin 1 (BB_G12)."
      },
      {
        "type": "modified",
        "wireId": "wire_1786644831573_rbmhi",
        "original": {
          "startHole": "BB_C34",
          "endHole": "LED_IN_5"
        },
        "corrected": {
          "startHole": "BB_D34",
          "endHole": "BB_G13"
        },
        "reason": "Rerouted carry out C_4 from driving LED_IN_5 directly to XOR Gate 1 input Pin 2 (BB_G13)."
      },
      {
        "type": "added",
        "wireId": "wire_fix_xor_to_v",
        "reason": "Connected XOR Gate 1 output Pin 3 (BB_G14 / V = C_3 XOR C_4) to LED_IN_5 (signed overflow indicator)."
      }
    ]
  },
